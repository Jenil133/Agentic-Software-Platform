generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  projects      Project[]
  agentRuns     AgentRun[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String     @id @default(cuid())
  name        String
  description String?
  template    String     @default("blank")
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  files       File[]
  agentRuns   AgentRun[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([ownerId])
}

model File {
  id        String   @id @default(cuid())
  projectId String
  path      String
  contents  String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, path])
  @@index([projectId])
}

model AgentRun {
  id         String    @id @default(cuid())
  projectId  String
  userId     String
  prompt     String
  status     String    @default("pending")
  result     String?
  tokensUsed Int       @default(0)
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   Message[]
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([projectId])
  @@index([userId])
}

model Message {
  id         String   @id @default(cuid())
  agentRunId String
  role       String
  content    String
  toolName   String?
  toolCallId String?
  toolArgs   String?
  toolResult String?
  agentRun   AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([agentRunId])
}
